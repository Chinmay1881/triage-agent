# Copy to .env and change every password. .env is git-ignored; never commit it.

# LLM
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# real | mock (tests always force mock)
LLM_MODE=real

# Eval harness limits: free | paid. Paid doesn't enforce the daily spend log; set its real limits
# from the Groq console with EVAL_PAID_TPM_LIMIT, EVAL_PAID_DAILY_TOKENS, EVAL_PAID_ENFORCE_DAILY.
EVAL_TIER=free

# MongoDB container. Users are created only on first start of an empty volume;
# after changing these, run `python tasks.py down --volumes` then `python tasks.py up`.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_TELEMETRY_READER_PASSWORD=change-me-reader
MONGO_APP_PASSWORD=change-me-app
MONGO_SEEDER_PASSWORD=change-me-seeder

# Connection strings the backend uses. Passwords must match the ones above.
TELEMETRY_MONGO_URI=mongodb://telemetry_reader:change-me-reader@127.0.0.1:27017/telemetry?authSource=telemetry
TRIAGE_MONGO_URI=mongodb://app:change-me-app@127.0.0.1:27017/triage?authSource=triage
# Write access to telemetry, used only by scripts/load.py (python tasks.py seed).
SEEDER_MONGO_URI=mongodb://seeder:change-me-seeder@127.0.0.1:27017/telemetry?authSource=telemetry
